# Copy to .env.local for `npm run dev`. For the Docker image these are build
# arguments instead (see Dockerfile): NEXT_PUBLIC_* values end up in the browser
# bundle, so they must never hold secrets.

# Where the browser reaches the backend API and its Socket.IO server
NEXT_PUBLIC_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_API_URL=http://localhost:9000

# Google sign-in (OAuth client ID, public)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
